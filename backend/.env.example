# ============================================================
# Backend environment — کپی کنید به .env و مقادیر واقعی را بگذارید
# Copy to .env and fill real values. Never share .env publicly.
# ============================================================

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,aipolynet.com,www.aipolynet.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://aipolynet.com,https://www.aipolynet.com
CORS_ALLOWED_ORIGINS=https://aipolynet.com,https://www.aipolynet.com

POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432

TON_SERVICE_URL=http://tonservice:3001
TONCENTER_MAINNET_URL=https://toncenter.com
TONCENTER_TESTNET_URL=https://testnet.toncenter.com

# کلیدها و آدرس‌های واقعی خودتان را بگذارید
TON_PRIVATE_KEY=
GRAM_MERCHANT_ADDRESS=
GRAM_WALLET_ADDRESS=
ADMIN_2FA_SECRET=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
